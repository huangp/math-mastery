# 复制为 credit.env（已 gitignore，chmod 600）。
# 必须与 Mac mini 上 /etc/screentime/web.yaml 的 code_secret 完全一致，否则发出的码兑不了
CODE_SECRET=CHANGE_ME
# screentime config.yaml 里的 pool 名，逗号分隔
KIDS=amelia,jayden
# 每个孩子每天最多从数学领取的分钟数（screentime 银行另有 earned_daily_cap）
DAILY_CAP=45
# 「今天」按这个时区的午夜切换，应与 screentime 守护进程一致：在 Mac mini 上跑
#   timedatectl show -p Timezone --value
TZ=CHANGE_ME
